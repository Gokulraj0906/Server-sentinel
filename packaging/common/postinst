#!/bin/sh
set -e
mkdir -p /var/lib/server-sentinel/incidents /var/lib/server-sentinel/reports
# The data directory holds command lines and file history, and the config
# may hold SMTP/webhook credentials: root only.
chmod 700 /var/lib/server-sentinel
chmod 600 /etc/server-sentinel/server-sentinel.toml 2>/dev/null || true
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    echo "server-sentinel installed. Review /etc/server-sentinel/server-sentinel.toml, then:"
    echo "  sudo systemctl enable --now server-sentinel"
    echo "  sudo server-sentinel doctor      # what this host can and can't be audited for"
fi
exit 0
