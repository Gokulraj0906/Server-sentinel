[Unit]
Description=ServerSentinel monitoring agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/server-sentinel --config /etc/server-sentinel/server-sentinel.toml
WorkingDirectory=/var/lib/server-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
